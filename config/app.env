# 线上运行配置（不含密钥，随源码一起发布）
#
# 修改后需要重新发布才生效。
# ACCESS_SECRET 放在 .env.production，用于门禁签名和账号 API 密钥加密；第三方 API 密钥由用户在账号页录入。

# 登录方式
#   email    = 一律要求输入邮箱，核对白名单后进入（当前使用）
#   platform = 平台登录的邮箱在白名单内就直接放行
ACCESS_MODE=email

# 邮箱白名单（逗号分隔，不区分大小写）。
# 名单内每个邮箱拥有各自独立的数据空间，互相看不到对方的产品、内容和素材。
# 要新增可以访问的人：把邮箱加到这里，然后重新发布一次。
ALLOWED_EMAILS=akiautumnovo@gmail.com

# AI / 搜索 / 图库的 provider 选择（密钥由每个白名单账号独立配置）
AI_PROVIDER=deepseek
# 两个搜索源按顺序故障转移
SEARCH_PROVIDER_ORDER=bocha,tavily
MEDIA_PROVIDER=pixabay
